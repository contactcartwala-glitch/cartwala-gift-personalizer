// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model SignatureDayDesign {
  id          String   @id @default(uuid())
  shop        String
  previewUrls Json
  printUrls   Json
  sourceUrls  Json
  shirtSizes  Json
  backPrint   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([shop, createdAt])
}

model ProductGroupSettings {
  shopId    String   @id
  state     Json
  revision  Int      @default(1)
  updatedAt DateTime @updatedAt
}

model GoogleReviewSnapshot {
  shop      String   @id
  payload   Json
  fetchedAt DateTime @default(now())
}

model PhotoOriginalArchive {
  id        String   @id @default(uuid())
  shop      String
  hash      String
  fileId    String?
  url       String?
  byteSize  Int
  photoCount Int
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())
  deletedAt DateTime?
  orders PhotoOriginalArchiveOrder[]

  @@unique([shop, hash])
  @@index([shop, deletedAt, createdAt])
}

model PhotoOriginalArchiveOrder {
  archiveId String
  orderId String
  completedAt DateTime?
  archive PhotoOriginalArchive @relation(fields: [archiveId], references: [id], onDelete: Cascade)

  @@id([archiveId, orderId])
  @@index([orderId])
}

model PartialCodIntent {
  id                 String   @id @default(uuid())
  shop               String
  requestKey         String
  state              String   @default("awaiting_payment")
  currency           String   @default("INR")
  orderPaise         Int
  advancePercent     Int      @default(20)
  codFeePaise        Int      @default(5000)
  payableNowPaise    Int
  collectPaise       Int
  lines              Json
  shippingAddress    Json
  accountingSnapshot Json?
  depositDraftId     String?  @unique
  depositOrderId     String?  @unique
  paymentFingerprint String?  @unique
  codOrderId         String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  outbox             PartialCodOutbox?
  paytmAttempt       PartialCodPaytmAttempt?
  orderAttempt       PartialCodOrderAttempt?

  @@unique([shop, requestKey])
  @@index([shop, state, createdAt])
}

model PartialCodOutbox {
  id         String   @id @default(uuid())
  intentId   String   @unique
  intent     PartialCodIntent @relation(fields: [intentId], references: [id], onDelete: Restrict)
  state      String   @default("ready")
  claimToken String?
  result     Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PartialCodSettings {
  shop           String   @id
  enabled        Boolean  @default(false)
  advancePercent Int      @default(20)
  codFeePaise    Int      @default(5000)
  revision       Int      @default(1)
  updatedAt      DateTime @updatedAt
}

model PartialCodPaytmAttempt {
  intentId           String   @id
  intent             PartialCodIntent @relation(fields: [intentId], references: [id], onDelete: Restrict)
  orderId            String   @unique
  environment        String
  merchantId         String
  payableNowPaise     Int
  state              String   @default("created")
  claimToken         String?
  transactionId      String?
  paymentFingerprint String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  lastCheckedAt      DateTime?
}

model PartialCodOrderAttempt {
  intentId           String   @id
  intent             PartialCodIntent @relation(fields: [intentId], references: [id], onDelete: Restrict)
  orderReference     String   @unique
  paymentFingerprint String   @unique
  payloadHash        String
  state              String   @default("processing")
  claimToken         String
  candidateOrderId   String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model CodAccountingDiagnostic {
  id         String   @id
  shop       String
  state      String   @default("processing")
  claimToken String
  orderId    String?  @unique
  observed   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

