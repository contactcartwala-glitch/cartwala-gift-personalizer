// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model SignatureDayDesign {
  id          String   @id @default(uuid())
  shop        String
  previewUrls Json
  printUrls   Json
  sourceUrls  Json
  shirtSizes  Json
  backPrint   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([shop, createdAt])
}

model ProductGroupSettings {
  shopId    String   @id
  state     Json
  revision  Int      @default(1)
  updatedAt DateTime @updatedAt
}

model GoogleReviewSnapshot {
  shop      String   @id
  payload   Json
  fetchedAt DateTime @default(now())
}

model CodAccountingDiagnostic {
  id         String   @id
  shop       String
  state      String   @default("processing")
  claimToken String
  orderId    String?  @unique
  observed   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CodThemeReviewSettings {
  shop           String   @id
  enabled        Boolean  @default(false)
  customerEnabled Boolean @default(false)
  advancePercent Int      @default(20)
  codFeePaise     Int      @default(5000)
  revision       Int      @default(0)
  updatedAt      DateTime @default(now()) @updatedAt
}


model NativeCodCheckout {
  id           String   @id
  shop         String
  quote        Json
  state        String   @default("creating")
  draftId      String?  @unique
  orderId      String?  @unique
  editClaim    String?
  calculatedId String?
  fingerprint  String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([shop, state])
}
