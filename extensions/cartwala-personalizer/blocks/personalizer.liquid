{% liquid
  assign group_config = product.metafields['app--421161926657'].group_config.value
  assign group_variant_key = product.selected_or_first_available_variant.id | append: ''
  assign group_preview = group_config.previews[group_variant_key]
  assign acrylic_room = collections['acrylic-photo-frames'].metafields['app--421161926657'].acrylic_room.value
  assign personalizer_config = product.metafields.cartwala_personalizer.personalizer_config.value
  if personalizer_config == blank
    assign personalizer_config = product.metafields['app--340764327937'].personalizer_config.value
  endif
  assign acrylic_design = personalizer_config.acrylicDesign
  if acrylic_design.masterProductId != blank
    assign group_config = nil
  endif
  assign personalizer_enabled = personalizer_config.enabled
  assign acrylic_product = false
  if group_config == blank
    if product.tags contains 'cw-acrylic-frame' or product.tags contains 'cw-acrylic-portrait' or product.tags contains 'cw-acrylic-landscape'
    assign acrylic_product = true
    assign personalizer_enabled = true
    endif
  endif
  if group_config.groupId != blank and group_config.customization == 'plain'
    assign personalizer_enabled = true
  endif
  assign acrylic_master = all_products['customized-acrylic-photo-frame']
  assign acrylic_fixed_orientation = ''
  if product.tags contains 'cw-acrylic-landscape' or product.tags contains 'cw-frame-landscape'
    assign acrylic_fixed_orientation = 'Landscape'
  elsif product.tags contains 'cw-acrylic-portrait' or product.tags contains 'cw-frame-portrait'
    assign acrylic_fixed_orientation = 'Portrait'
  endif
  if acrylic_design.masterProductId != blank
    assign acrylic_product = true
    assign acrylic_fixed_orientation = acrylic_design.orientation
  endif
  assign acrylic_plain_photo = false
  if group_config.groupId != blank and group_config.customization == 'plain' and personalizer_config == blank
    assign acrylic_plain_photo = true
  elsif acrylic_product and personalizer_config == blank
    assign acrylic_plain_photo = true
  endif
  assign mug_product = false
  assign mug_model = 'white'
  if product.tags contains 'cw-mug'
    assign mug_product = true
  endif
  if product.tags contains 'cw-mug-model-magic'
    assign mug_model = 'magic'
  elsif product.tags contains 'cw-mug-model-love-handle'
    assign mug_model = 'love-handle'
  elsif product.tags contains 'cw-mug-model-red'
    assign mug_model = 'red'
  endif
  assign heart_magic_mirror_fallback = false
  if product.id == 8677823381689
    assign personalizer_enabled = true
    assign heart_magic_mirror_fallback = true
  endif
  if request.design_mode
    assign personalizer_enabled = true
  endif
%}

{% if group_config.groupId != blank %}
  <div data-cw-product-group {% if product.id == 15402886135993 and group_config.customization == 'plain' %}data-acrylic-live-room="{{ 'cartwala-acrylic-room.jpg' | asset_url }}" data-acrylic-mockups="{{ product.metafields['app--421161926657'].acrylic_mockups.value | json | escape }}"{% endif %} data-config="{{ group_config | json | escape }}" data-options="{{ product.options | json | escape }}" data-variants="{{ product.variants | json | escape }}" data-product-id="{{ product.id }}" data-variant="{{ product.selected_or_first_available_variant.id }}" data-artwork="{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 2400 }}{% endif %}" data-stud="{{ 'cartwala-acrylic-stud.png' | asset_url }}" hidden></div>
  <script src="{{ 'cartwala-product-groups.js' | asset_url }}" defer></script>
  {{ 'cartwala-product-groups.css' | asset_url | stylesheet_tag }}
{% endif %}
{% if personalizer_enabled %}
  {{ 'cartwala-loading.css' | asset_url | stylesheet_tag }}
  <div class="cw-personalizer" data-cw-personalizer data-product-kind="{% if mug_product %}mug{% else %}gift{% endif %}" {% if acrylic_product or acrylic_plain_photo %}data-cw-acrylic-product="true"{% endif %} data-cw-mug-model="{{ mug_model }}" data-label-edit="{{ 'personalizer.edit_again' | t | escape }}" data-label-saved="{{ 'personalizer.saved_preview' | t | escape }}" data-product-id="{{ product.id }}" data-overlay="{% if heart_magic_mirror_fallback %}https://cdn.shopify.com/s/files/1/0803/7931/4361/files/love_shape-overlay_019e41fb-91c2-47b6-8017-ffcfa79af20c.png?v=1789700102{% elsif acrylic_plain_photo %}{% else %}{{ personalizer_config.overlayUrl | escape }}{% endif %}" data-accent="#ff6200" data-label-upload="{{ 'personalizer.upload' | t | escape }}" data-label-reset="{{ 'personalizer.reset' | t | escape }}" data-label-zoom="{{ 'personalizer.zoom' | t | escape }}" data-label-rotation="{{ 'personalizer.rotation' | t | escape }}" data-label-change="{{ 'personalizer.change_photo' | t | escape }}" data-label-font="{{ 'personalizer.font' | t | escape }}" data-label-required="{{ 'personalizer.required' | t | escape }}" data-label-file="{{ 'personalizer.choose_file' | t | escape }}" {{ block.shopify_attributes }}>
    {% if heart_magic_mirror_fallback %}
      <div data-cw-config='{"enabled":true,"overlayUrl":"https://cdn.shopify.com/s/files/1/0803/7931/4361/files/love_shape-overlay_019e41fb-91c2-47b6-8017-ffcfa79af20c.png?v=1789700102","canvasRatio":"1254:1254","photoFields":[{"id":"photo-1","label":"1 MASK","maskUrl":"https://cdn.shopify.com/s/files/1/0803/7931/4361/files/psd-photo-mask-1_0cf43e8b-95f1-477d-ba79-84c22c4314bb.png?v=1789700105","x":49.68102073365231,"y":40.82934609250399,"width":63.31738437001595,"height":55.18341307814992,"rotationEnabled":false,"required":true}],"textFields":[],"fileFields":[],"linkFields":[],"customFonts":[]}' hidden></div>
    {% elsif acrylic_plain_photo %}
      <div data-cw-config='{"enabled":true,"canvasRatio":"{% if group_preview != blank %}{{ group_preview.widthInches | times: 100 | round }}:{{ group_preview.heightInches | times: 100 | round }}{% elsif product.selected_or_first_available_variant.option3 == 'Landscape' or acrylic_fixed_orientation == 'Landscape' %}12:8{% else %}8:12{% endif %}","photoFields":[{"id":"acrylic-photo","label":"Your Photo","x":50,"y":50,"width":100,"height":100,"required":true}],"textFields":[],"fileFields":[],"linkFields":[],"customFonts":[]}' hidden></div>
    {% else %}
      <div data-cw-config="{{ personalizer_config | json | escape }}" hidden></div>
    {% endif %}
    {% if acrylic_product %}
      <div data-cw-acrylic data-master-mockups="{{ acrylic_master.metafields['app--421161926657'].acrylic_mockups.value | json | escape }}" data-master-previews="{{ acrylic_master.metafields['app--421161926657'].group_config.value.previews | json | escape }}" data-option-names="{{ product.options | json | escape }}" data-design-ratio="{{ personalizer_config.canvasRatio | escape }}" data-fixed-orientation="{{ acrylic_fixed_orientation }}" data-design-image="{% if acrylic_fixed_orientation != blank and product.featured_image != blank %}{{ product.featured_image | image_url: width: 2400 }}{% endif %}" data-variants="{{ product.variants | json | escape }}" data-selected-variant="{{ product.selected_or_first_available_variant.id }}" data-room-image="{% if acrylic_room != blank %}{{ acrylic_room | image_url: width: 2000 }}{% else %}{{ 'cartwala-acrylic-room.jpg' | asset_url }}{% endif %}" data-stud-image="{{ 'cartwala-acrylic-stud.png' | asset_url }}" hidden></div>
      <script src="{{ 'cartwala-acrylic-frame.js' | asset_url }}" defer></script>
      {{ 'cartwala-acrylic-frame.css' | asset_url | stylesheet_tag }}
    {% endif %}
    <button class="cw-personalizer__open" type="button" data-cw-open>{{ 'personalizer.customize' | t }}</button>
    {% if product.id == 15416028364985 %}
      <section class="cw-clock-product-preview" data-cw-clock-product-preview hidden>
        <header class="cw-clock-product-preview__head">
          <div><p>LIVE PREVIEW</p><h2>Your 3D Photo Clock</h2><span>Drag the clock to rotate. Tap a photo below to crop or change it.</span></div>
          <button type="button" class="cw-clock-product-preview__badge" data-cw-clock-focus-3d><span aria-hidden="true">↻</span><strong>3D</strong></button>
        </header>
        <div class="cw-clock-product-preview__stage" data-cw-clock-product-stage tabindex="0" aria-label="Rotatable 3D photo clock preview">
          <div class="cw-clock-product-cube" data-cw-clock-product-cube>
            <div class="cw-clock-product-face cw-clock-product-face--front">
              <div class="cw-clock-product-screen"><strong>12:12</strong><span>THU&nbsp;&nbsp;8/1&nbsp;&nbsp;&nbsp;27°C</span></div>
            </div>
            <div class="cw-clock-product-face cw-clock-product-face--back"><img data-cw-clock-product-face-image="back" alt=""></div>
            <div class="cw-clock-product-face cw-clock-product-face--left"><img data-cw-clock-product-face-image="left" alt=""></div>
            <div class="cw-clock-product-face cw-clock-product-face--right"><img data-cw-clock-product-face-image="right" alt=""></div>
            <div class="cw-clock-product-face cw-clock-product-face--top"><img data-cw-clock-product-face-image="top" alt=""></div>
            <div class="cw-clock-product-face cw-clock-product-face--bottom"><img src="https://cdn.shopify.com/s/files/1/0803/7931/4361/files/photo-cube-clock-bottom-side.jpg?v=1791288117" alt="Clock bottom controls"></div>
          </div>
        </div>
        <div class="cw-clock-product-preview__views" role="group" aria-label="Clock views">
          <button type="button" data-cw-clock-product-view="front">Front</button>
          <button type="button" data-cw-clock-product-view="top">Top</button>
          <button type="button" data-cw-clock-product-view="left">Left</button>
          <button type="button" data-cw-clock-product-view="right">Right</button>
          <button type="button" data-cw-clock-product-view="back">Back</button>
          <button type="button" data-cw-clock-product-view="bottom">Bottom</button>
        </div>
        <div class="cw-clock-product-preview__photos" data-cw-clock-product-thumbs>
          {% assign cw_clock_sides = 'top,left,right,back' | split: ',' %}
          {% for cw_side in cw_clock_sides %}
            <button type="button" class="cw-clock-product-thumb" data-cw-clock-edit-side="{{ cw_side }}">
              <span class="cw-clock-product-thumb__image"><img data-cw-clock-thumb-image="{{ cw_side }}" alt="{{ cw_side | capitalize }} photo"></span>
              <span class="cw-clock-product-thumb__copy"><strong>{{ cw_side | capitalize }}</strong><small>Crop / Edit</small></span>
            </button>
          {% endfor %}
        </div>
      </section>
    {% endif %}
    {% if mug_product %}
      <section class="cw-mug-preview cw-mug-preview--{{ mug_model }}" data-cw-mug-preview data-cw-render-fallback="{{ 'mug_preview.render_fallback' | t | escape }}" hidden>
        <header class="cw-mug-preview__heading"><div><p>{{ 'mug_preview.eyebrow' | t }}</p><h2>{{ 'mug_preview.views_title' | t }}</h2></div><span>{{ 'mug_preview.live' | t }}</span></header>
        <div class="cw-mug-preview__views" role="group" aria-label="{{ 'mug_preview.views_label' | t | escape }}">
          <figure class="cw-mug-preview__view"><div class="cw-mug-preview__view-stage"><div class="cw-mug-preview__scene" data-cw-mug-scene data-cw-rotation-y="170" data-cw-rotation-x="-18"></div></div><figcaption>{{ 'mug_preview.left_view' | t }}</figcaption></figure>
          <figure class="cw-mug-preview__view"><div class="cw-mug-preview__view-stage"><div class="cw-mug-preview__scene" data-cw-mug-scene data-cw-rotation-y="90" data-cw-rotation-x="-18"></div></div><figcaption>{{ 'mug_preview.front_view' | t }}</figcaption></figure>
          <figure class="cw-mug-preview__view"><div class="cw-mug-preview__view-stage"><div class="cw-mug-preview__scene" data-cw-mug-scene data-cw-rotation-y="10" data-cw-rotation-x="-18"></div></div><figcaption>{{ 'mug_preview.right_view' | t }}</figcaption></figure>
        </div>
        {% if mug_model == 'magic' %}
          <button class="cw-mug-preview__heat" type="button" data-cw-magic-toggle data-cold-label="{{ 'mug_preview.pour_hot_water' | t | escape }}" data-hot-label="{{ 'mug_preview.cool_magic_mug' | t | escape }}" aria-pressed="false">{{ 'mug_preview.pour_hot_water' | t }}</button>
        {% endif %}
        <button class="cw-mug-preview__open-3d" type="button" data-cw-mug-open commandfor="cw-mug-dialog-{{ block.id }}" command="show-modal" onclick="var dialog=document.getElementById('cw-mug-dialog-{{ block.id }}');setTimeout(function(){if(dialog&&!dialog.open){if(typeof dialog.showModal==='function'){dialog.showModal();}else{dialog.setAttribute('open','');}}});" aria-label="{{ 'mug_preview.open_3d' | t | escape }}"><span aria-hidden="true">↻</span><strong>3D</strong></button>
      </section>
      <dialog id="cw-mug-dialog-{{ block.id }}" class="cw-mug-modal cw-mug-modal--{{ mug_model }}" data-cw-mug-dialog aria-labelledby="cw-mug-modal-title-{{ block.id }}">
        <div class="cw-mug-modal__panel">
          <header><h2 id="cw-mug-modal-title-{{ block.id }}">{{ 'mug_preview.modal_title' | t }}</h2><button type="button" data-cw-mug-close aria-label="{{ 'personalizer.close' | t | escape }}">×</button></header>
          <div class="cw-mug-modal__stage" data-cw-mug-stage tabindex="0" role="img" aria-label="{{ 'mug_preview.stage_label' | t | escape }}"><div class="cw-mug-preview__scene" data-cw-mug-scene data-cw-rotation-y="25" data-cw-rotation-x="-22"></div></div>
          {% if mug_model == 'magic' %}
            <button class="cw-mug-preview__heat" type="button" data-cw-magic-toggle data-cold-label="{{ 'mug_preview.pour_hot_water' | t | escape }}" data-hot-label="{{ 'mug_preview.cool_magic_mug' | t | escape }}" aria-pressed="false">{{ 'mug_preview.pour_hot_water' | t }}</button>
          {% endif %}
          <p>{{ 'mug_preview.free_drag_help' | t }}</p>
        </div>
      </dialog>
    {% endif %}
    <dialog class="cw-personalizer__dialog" data-cw-dialog>
      <div class="cw-personalizer__panel">
        <div class="cw-personalizer__header"><div class="cw-personalizer__brand"><span class="cw-personalizer__brand-mark">C</span><strong>Cartwala Customizer</strong></div><button type="button" class="cw-personalizer__close" data-cw-close aria-label="{{ 'personalizer.close' | t }}">×</button></div>
        <div class="cw-personalizer__toolbar"><div class="cw-personalizer__toolbar-left"><button type="button" class="cw-personalizer__toolbar-reset" data-cw-reset-all>↻ Reset</button><button type="button" class="cw-personalizer__toolbar-change" data-cw-change-photo>▣ Change Photo</button></div><button type="button" class="cw-personalizer__preview cw-personalizer__preview--top" data-cw-save disabled>Preview &amp; Save</button></div>
        <div class="cw-personalizer__workspace"><div class="cw-personalizer__canvas-pane"><div class="cw-personalizer__stage" data-cw-stage><div class="cw-personalizer__photo-layers" data-cw-photo-layers></div><div class="cw-personalizer__text-layers" data-cw-text-layers></div><img class="cw-personalizer__overlay" data-cw-overlay alt="" aria-hidden="true" width="1200" height="1200"><div class="cw-personalizer__result" data-cw-result hidden><img data-cw-result-image class="cw-personalizer__result-image" alt="{{ 'personalizer.saved_preview' | t }}" width="800" height="800"></div></div><div class="cw-personalizer__tip"><strong>Tip:</strong> To Move - Swipe / Drag &nbsp; · &nbsp; To Zoom - Pinch in/out / Corners</div></div><aside class="cw-personalizer__controls-pane"><div class="cw-personalizer__fields" data-cw-editor-fields></div></aside></div>
      </div>
    </dialog>
  </div>
  <script src="{{ 'cartwala-direct-checkout.js' | asset_url }}" defer></script>
  <script src="{{ 'cartwala-cart-retry.js' | asset_url }}" defer></script>
  <script src="{{ 'cartwala-selection-box.js' | asset_url }}" defer></script>
  <script src="{{ 'cartwala-editor-ui.js' | asset_url }}" defer></script>
  <script src="{{ 'cartwala-print-metadata.js' | asset_url }}" defer></script>
  <script src="{{ 'cartwala-cart-fix.js' | asset_url }}" defer></script>
  <script src="{{ 'cartwala-loading.js' | asset_url }}" defer></script>
  <script src="{{ 'cartwala-preview-fit-fix.js' | asset_url }}" defer></script>
  <script src="{{ 'cartwala-stability-fix.js' | asset_url }}" defer></script>
{% endif %}

{% if block.settings.show_delivery_dates %}
  <div
    class="cw-delivery-estimate"
    data-cw-delivery-estimate
    data-dispatch-start="{{ block.settings.dispatch_start_days }}"
    data-dispatch-end="{{ block.settings.dispatch_end_days }}"
    data-delivery-start="{{ block.settings.delivery_start_days }}"
    data-delivery-end="{{ block.settings.delivery_end_days }}"
    data-dispatch-label="{{ 'personalizer.ready_to_dispatch' | t | escape }}"
    data-delivery-label="{{ 'personalizer.estimated_delivery' | t | escape }}"
    aria-live="polite"
    {{ block.shopify_attributes }}
  >
    <div class="cw-delivery-estimate__step">
      <span class="cw-delivery-estimate__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 8h12l-1 12H7L6 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2m-5 6 1.5 1.5L15 12"/></svg></span>
      <strong>{{ 'personalizer.ordered' | t }}</strong>
      <span class="cw-delivery-estimate__date" data-cw-ordered-date></span>
    </div>
    <span class="cw-delivery-estimate__line" aria-hidden="true"></span>
    <div class="cw-delivery-estimate__step">
      <span class="cw-delivery-estimate__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 6h11v10H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg></span>
      <strong>{{ 'personalizer.order_ready' | t }}</strong>
      <span class="cw-delivery-estimate__date" data-cw-dispatch-dates></span>
    </div>
    <span class="cw-delivery-estimate__line" aria-hidden="true"></span>
    <div class="cw-delivery-estimate__step">
      <span class="cw-delivery-estimate__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 21s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg></span>
      <strong>{{ 'personalizer.delivered' | t }}</strong>
      <span class="cw-delivery-estimate__date" data-cw-delivery-dates></span>
    </div>
  </div>
  <script src="{{ 'cartwala-delivery-estimate.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{"name":"t:personalizer.block_name","target":"section","javascript":"cartwala-personalizer.js","stylesheet":"cartwala-personalizer.css","enabled_on":{"templates":["product"]},"settings":[{"type":"color","id":"accent_color","label":"t:personalizer.accent_color","default":"#ff6200"},{"type":"checkbox","id":"show_delivery_dates","label":"t:personalizer.show_delivery_dates","default":true},{"type":"range","id":"dispatch_start_days","label":"t:personalizer.dispatch_start_days","min":0,"max":14,"step":1,"default":2},{"type":"range","id":"dispatch_end_days","label":"t:personalizer.dispatch_end_days","min":0,"max":14,"step":1,"default":3},{"type":"range","id":"delivery_start_days","label":"t:personalizer.delivery_start_days","min":1,"max":30,"step":1,"default":7},{"type":"range","id":"delivery_end_days","label":"t:personalizer.delivery_end_days","min":1,"max":30,"step":1,"default":8}]}
{% endschema %}
