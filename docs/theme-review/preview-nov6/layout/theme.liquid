<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="canonical" href="{{ canonical_url }}"><title>{% if request.page_type == 'index' %}Personalised Gifts & Photo Frames Online | Cartwala{% else %}{{ page_title }}{% if current_tags %} – tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} – Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}{% endif %}</title>{% render 'meta-tags' %}{% render 'cartwala-collection-schema' %}{% render 'cartwala-photobook-product-schema' %}{% render 'cartwala-generic-product-schema' %}{% render 'cartwala-site-identity-schema' %}{% if request.page_type == 'cart' or request.page_type == 'search' %}<meta name="robots" content="noindex,follow">{% endif %}{{ 'base.css' | asset_url | stylesheet_tag: preload: true }}
{% if request.page_type == 'product' and product.tags contains 'cw-mug' %}<script src="{{ 'cartwala-mug-3d-review.js' | asset_url }}" defer data-cw-mug-studio-script="{{ 'cartwala-mug-studio.js' | asset_url }}" data-cw-mug-studio-model="{{ 'cartwala-white-mug.glb' | asset_url }}"></script>{% endif %}
{% if request.page_type == 'product' %}
