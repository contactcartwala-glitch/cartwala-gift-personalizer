<script>document.documentElement.className=document.documentElement.className.replace('no-js','js');window.Cartwala={routes:{cart_add_url:'{{ routes.cart_add_url }}.js',cart_change_url:'{{ routes.cart_change_url }}.js',cart_url:'{{ routes.cart_url }}.js',predictive_search_url:'{{ routes.predictive_search_url }}.json'}};</script>
{% if request.page_type == 'product' %}{{ 'cartwala-single-cta.css' | asset_url | stylesheet_tag }}{% endif %}
{% if request.page_type == 'product' %}{{ 'cartwala-product-ux.css' | asset_url | stylesheet_tag }}{% endif %}
{% if request.page_type == 'product' %}<script>(function(){try{if(new URLSearchParams(location.search).get('cw_start_design')==='1'){document.documentElement.classList.add('cw-mug-direct-pending')}}catch(e){}})();</script>{% endif %}
{% if request.page_type == 'product' %}{{ 'cartwala-mug-direct-flow.css' | asset_url | stylesheet_tag }}{% endif %}
{% if request.page_type == 'product' %}{{ 'cartwala-instant-cart-loading.css' | asset_url | stylesheet_tag }}{% endif %}
