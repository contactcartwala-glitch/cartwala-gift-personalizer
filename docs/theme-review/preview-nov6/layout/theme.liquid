</head><body><a class="skip-to-content-link" href="#MainContent">Skip to content</a>{% sections 'header-group' %}<main id="MainContent" role="main">{{ content_for_layout }}</main>{% sections 'footer-group' %}{% render 'cart-drawer' %}<div id="cw-toast" class="toast" role="status" aria-live="polite"></div>

