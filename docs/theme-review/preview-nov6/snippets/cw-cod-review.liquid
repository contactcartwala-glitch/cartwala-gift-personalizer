{% doc %}
  Renders an unpaid Advance COD layout review in the unpublished review theme.
  @example
  {% render 'cw-cod-review' %}
{% enddoc %}
{% if settings.cw_cod_review_enabled %}
  {{ 'cw-cod-review.css' | asset_url | stylesheet_tag }}
  <dialog data-cw-cod-review data-percent="{{ settings.cw_cod_review_percent | default: 20 }}" data-fee="{{ settings.cw_cod_review_fee | default: 50 | times: 100 | round }}" aria-labelledby="cw-cod-review-title" aria-describedby="cw-cod-review-notice">
    <button type="button" class="cw-cod-close" data-cod-close aria-label="{{ 'cod_review.close' | t }}">×</button>
    <h2 id="cw-cod-review-title">{{ 'cod_review.heading' | t }}</h2>
    <p class="cw-cod-note" id="cw-cod-review-notice">{{ 'cod_review.preview' | t }}</p>
    <form>
      <fieldset>
        <legend class="visually-hidden">{{ 'cod_review.heading' | t }}</legend>
        <label class="cw-cod-option"><input type="radio" name="cw_cod_choice" value="prepaid" checked><span><strong>{{ 'cod_review.prepaid' | t }} <span data-cod-full></span></strong><span>{{ 'cod_review.prepaid_hint' | t }}</span></span></label>
        <label class="cw-cod-option"><input type="radio" name="cw_cod_choice" value="cod"><span><strong>{{ 'cod_review.cod' | t }}</strong><span>{{ 'cod_review.cod_hint' | t }}</span></span></label>
      </fieldset>
      <div data-cod-amounts hidden>
        <dl data-cod-breakdown hidden>
          <div><dt>{{ 'cod_review.goods' | t }}</dt><dd data-cod-full></dd></div>
          <div><dt>{{ 'cod_review.advance' | t }} (<span data-cod-percent></span>)</dt><dd data-cod-advance></dd></div>
          <div><dt>{{ 'cod_review.fee' | t }}</dt><dd data-cod-fee></dd></div>
          <div class="cw-cod-pay-now"><dt>{{ 'cod_review.now' | t }}</dt><dd data-cod-now></dd></div>
          <div><dt>{{ 'cod_review.balance' | t }}</dt><dd data-cod-balance></dd></div>
          <div><dt>{{ 'cod_review.total' | t }}</dt><dd data-cod-total></dd></div>
        </dl>
        <p class="cw-cod-note">{{ 'cod_review.estimate' | t }}</p>
      </div>
      <p class="cw-cod-note" role="status" aria-live="polite"></p>
      <button type="submit" data-cod-next disabled>{{ 'cod_review.continue_prepaid' | t }}</button>
    </form>
    <script type="application/json">{"loading":{{ 'cod_review.loading' | t | json }},"review_notice":{{ 'cod_review.review_notice' | t | json }},"unavailable":{{ 'cod_review.unavailable' | t | json }},"not_connected":{{ 'cod_review.not_connected' | t | json }},"continue_prepaid":{{ 'cod_review.continue_prepaid' | t | json }}}</script>
  </dialog>
  <script src="{{ 'cw-cod-review.js' | asset_url }}" defer></script>
{% endif %}
