{%- assign product = product -%}
{%- assign gift_preview = product.metafields.cartwala_personalizer.gift_config.value.previewUrl -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign size_guide_image = nil -%}
{%- assign gallery_count = 0 -%}
{%- assign main_media = product.featured_media -%}
{%- assign main_media_set = false -%}
{%- for media in product.media -%}{%- assign alt_lower = media.alt | downcase -%}{%- if alt_lower contains 'size guide' or alt_lower contains 'size chart' -%}{%- assign size_guide_image = media -%}{%- else -%}{%- assign gallery_count = gallery_count | plus: 1 -%}{%- unless main_media_set -%}{%- assign main_media = media -%}{%- assign main_media_set = true -%}{%- endunless -%}{%- endif -%}{%- endfor -%}
{%- if gallery_count == 0 -%}{%- assign gallery_count = product.media.size -%}{%- assign main_media = product.featured_media -%}{%- assign size_guide_image = nil -%}{%- endif -%}
<div class="page-width" style="padding-top:1.5rem;">{% render 'breadcrumbs' %}<div class="product-layout" style="margin-top:1rem;"><div data-product-gallery><div class="product-gallery__main" data-gallery-main>{% if gift_preview %}<img src="{{ gift_preview | escape }}&amp;width=1200" alt="{{ product.title | escape }}" width="900" height="900" fetchpriority="high">{% else %}<img src="{{ main_media | image_url: width: 900 }}" srcset="{{ main_media | image_url: width: 360 }} 360w, {{ main_media | image_url: width: 600 }} 600w, {{ main_media | image_url: width: 900 }} 900w, {{ main_media | image_url: width: 1200 }} 1200w" sizes="(min-width: 900px) 50vw, calc(100vw - 2rem)" alt="{{ main_media.alt | default: product.title | escape }}" width="900" height="900" fetchpriority="high">{% endif %}</div>{% if gallery_count > 1 and gift_preview == blank %}<div class="product-gallery__thumbs">{% for media in product.media %}{% assign thumb_alt_lower = media.alt | downcase %}{% unless thumb_alt_lower contains 'size guide' or thumb_alt_lower contains 'size chart' %}<button type="button" data-gallery-thumb data-media-id="{{ media.id }}" data-full-src="{{ media | image_url: width: 900 }}" class="{% if media == main_media %}is-active{% endif %}" aria-label="View image {{ forloop.index }}"><img src="{{ media | image_url: width: 150 }}" alt="" width="72" height="72" loading="lazy"></button>{% endunless %}{% endfor %}</div>{% endif %}</div><div>{% if product.metafields.custom.occasion %}<span class="badge">{{ product.metafields.custom.occasion }}</span>{% endif %}<h1 class="product-info__title" style="margin-top:.6rem;">{{ product.title }}</h1>{% if product.metafields.reviews.rating %}<div class="product-info__rating"><span style="color:var(--accent);">{% for i in (1..5) %}{% render 'icon', name: 'star', size: 15 %}{% endfor %}</span>{{ product.metafields.reviews.rating.value }} ({{ product.metafields.reviews.rating_count }} reviews)</div>{% endif %}<div class="product-info__price" data-product-price>{% render 'price', product: product, variant: current_variant %}</div>{% if product.metafields.custom.production_time or settings.default_production_days %}<p class="text-muted" style="font-size:.85rem;display:flex;align-items:center;gap:.4rem;">{% render 'icon', name: 'truck', size: 16 %} Production: {{ product.metafields.custom.production_time | default: settings.default_production_days }} day(s) &middot; Delivery: {{ product.metafields.custom.delivery_time | default: settings.default_delivery_days }} day(s)</p>{% endif %}<form method="post" action="{{ routes.cart_add_url }}" enctype="multipart/form-data" data-cart-form data-main-add-to-cart><input type="hidden" name="id" value="{{ current_variant.id }}">{% if product.has_only_default_variant == false %}{% capture variants_json %}[{% for v in product.variants %}{"id":{{ v.id | json }},"options":{{ v.options | json }},"available":{{ v.available | json }},"price_formatted":{{ v.price | money | json }},"compare_at_price_formatted":{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},"discount_pct":{% if v.compare_at_price > v.price %}{{ v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price | round | json }}{% else %}0{% endif %},"media_id":{% if v.featured_media %}{{ v.featured_media.id | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}]{% endcapture %}<div data-variant-picker data-variants="{{ variants_json | strip_newlines | escape }}">{% for option in product.options_with_values %}<div class="variant-group"><span class="variant-group__label">{{ option.name }}{% if option.name contains 'Size' %}<button type="button" data-size-guide-open class="size-guide-trigger">{% render 'icon', name: 'ruler', size: 14 %} Size Guide</button>{% endif %}</span><div class="swatch-row">{% for value in option.values %}<label class="swatch {% if value == option.selected_value %}is-selected{% endif %}"><input type="radio" name="option{{ option.position }}" value="{{ value | escape }}" {% if value == option.selected_value %}checked{% endif %}>{{ value }}</label>{% endfor %}</div></div>{% endfor %}</div>{% endif %}{% for block in section.blocks %}{% if block.type == '@app' %}{% render block %}{% endif %}{% endfor %}{% render 'bottle-birthday-personalizer', product: product %}{% if product.handle == 'love-hearts-personalized-couple-photo-mug-11-oz' %}{% render 'mug-personalizer-loader', product: product %}{% elsif product.handle == 'cw-pf-013-12-months-baby-photo-frame' or product.handle == '12-months-baby-photo-frame' or product.handle == 'flower-shape-led-magic-mirror-photo-frame' or product.metafields.custom.personalization_enabled.value or product.tags contains 'personalize' or product.tags contains 'Personalized Gift' %}{% render 'personalization-form', product: product %}{% endif %}<div class="variant-group"><span class="variant-group__label">{{ 'products.product.quantity' | t: default: 'Quantity' }}</span><div class="qty-selector"><button type="button" data-qty-step="-1" aria-label="Decrease quantity">{% render 'icon', name: 'minus', size: 14 %}</button><input type="number" name="quantity" value="1" min="1" aria-label="Quantity"><button type="button" data-qty-step="1" aria-label="Increase quantity">{% render 'icon', name: 'plus', size: 14 %}</button></div></div><button type="submit" class="btn btn-primary btn-block" data-add-to-cart data-label-available="Add to Cart" {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}{% render 'icon', name: 'bag', size: 18 %} Add to Cart{% else %}Sold Out{% endif %}</button></form><div class="cartwala-confidence" aria-label="Shopping confidence"><div class="cartwala-confidence__title">{% render 'icon', name: 'shield', size: 18 %}<span>Shop with confidence</span></div><div class="cartwala-confidence__grid"><div class="cartwala-confidence__item">{% render 'icon', name: 'shield', size: 20 %}<div><strong>Secure Checkout</strong></div></div><div class="cartwala-confidence__item">{% render 'icon', name: 'gift', size: 20 %}<div><strong>Carefully Packed</strong></div></div><div class="cartwala-confidence__item">{% render 'icon', name: 'truck', size: 20 %}<div><strong>Tracking Updates</strong></div></div><div class="cartwala-confidence__item">{% render 'icon', name: 'heart', size: 20 %}<div><strong>Customer Support</strong></div></div></div></div><div class="product-tabs" data-product-tabs><div class="product-tabs__nav"><button type="button" data-tab-trigger="description" class="is-active">Description</button><button type="button" data-tab-trigger="shipping">Shipping</button></div><div class="product-tabs__panel is-active" data-tab-panel="description">{{ product.description }}</div><div class="product-tabs__panel" data-tab-panel="shipping"><p>We ship across India via trusted courier partners. Orders are carefully packed to prevent damage in transit. You'll receive tracking details once your gift ships.</p></div></div></div></div></div>{% render 'size-guide-modal', image: size_guide_image %}<div class="sticky-atc" data-sticky-atc><img src="{{ main_media | image_url: width: 100 }}" alt="" width="44" height="44" style="width:44px;height:44px;object-fit:cover;border-radius:var(--radius-sm);"><div style="flex:1;"><div style="font-weight:600;font-size:.85rem;">{{ product.title | truncate: 28 }}</div><div data-product-price>{% render 'price', product: product, variant: current_variant %}</div></div><button type="button" class="btn btn-primary btn-sm" onclick="document.querySelector('[data-main-add-to-cart]').requestSubmit();">Add to Cart</button></div><style>#shopify-section-{{ section.id }} .cartwala-confidence{margin-top:14px;border:1px solid #e5e5e5;border-radius:14px;background:#fffaf6;padding:14px}#shopify-section-{{ section.id }} .cartwala-confidence__title{display:flex;align-items:center;gap:7px;margin-bottom:12px;color:#111;font-size:.95rem;font-weight:700}#shopify-section-{{ section.id }} .cartwala-confidence__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}#shopify-section-{{ section.id }} .cartwala-confidence__item{display:flex;align-items:flex-start;gap:8px;padding:10px;border:1px solid #eee;border-radius:10px;background:#fff}#shopify-section-{{ section.id }} .cartwala-confidence__item svg{color:#ff6a00}@media(min-width:900px){#shopify-section-{{ section.id }} .cartwala-confidence__grid{grid-template-columns:repeat(4,minmax(0,1fr))}}</style>{% schema %}{"name":"Main product","settings":[],"blocks":[{"type":"@app"}]}{% endschema %}

