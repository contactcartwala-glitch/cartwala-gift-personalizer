{% assign master_frame = all_products['customized-photo-frame-black-beading'] %}
{{ 'cartwala-mosaic.css' | asset_url | stylesheet_tag }}
<section class="mosaic-studio" data-mosaic-studio id="mosaic-studio-{{ section.id }}" data-product-id="{{ product.id }}" data-product-image="https://cdn.shopify.com/s/files/1/0803/7931/4361/files/cartwala-mosaic-master-frame-portrait.png?v=1791739000" data-landscape-image="https://cdn.shopify.com/s/files/1/0803/7931/4361/files/cartwala-mosaic-master-frame-landscape.png?v=1791739439" data-portrait-frame="https://cdn.shopify.com/s/files/1/0803/7931/4361/files/cartwala-black-beading-frame-portrait-2x3.png?v=1791608460" data-landscape-frame="https://cdn.shopify.com/s/files/1/0803/7931/4361/files/cartwala-black-beading-frame-landscape-3x2.png?v=1791608451">
<div class="mosaic-wrap"><div class="mosaic-grid">
<div><img class="mosaic-hero" data-hero src="https://cdn.shopify.com/s/files/1/0803/7931/4361/files/cartwala-mosaic-master-frame-portrait.png?v=1791739000" alt="Mosaic photo frame with premium black beading" width="1254" height="1254" fetchpriority="high"><div class="mosaic-preview-area" data-preview-area hidden>
        <div class="mosaic-empty" data-empty>Upload at least 10 background photos to see your preview.</div>
        <div class="mosaic-frame" data-frame hidden><div class="mosaic-stage"><canvas data-preview width="900" height="1350" aria-label="Mosaic photo frame preview in a two to three ratio"></canvas><button type="button" data-resize hidden aria-label="Resize main photo" title="Drag to resize main photo">↘</button></div></div>
<div class="mosaic-preview-tools"><button type="button" data-reset-placement hidden>Reset main photo</button><details class="mosaic-step mosaic-cutout" data-tools hidden><summary>Edit cutout</summary><div class="mosaic-cutout-content"><strong>Refine the cutout</strong><p>Use Restore to bring back details such as ears and eyes, or Erase to remove leftover background.</p><div class="mosaic-tool-row"><button type="button" data-mode="restore" aria-pressed="true">Restore</button><button type="button" data-mode="erase" aria-pressed="false">Erase</button><label>Brush size <input type="range" data-brush min="5" max="90" value="24"></label></div><canvas data-mask width="600" height="900" aria-label="Brush to refine the main portrait"></canvas><button type="button" data-reset-mask>Reset cutout</button></div></details></div>
      </div></div>
<div class="mosaic-controls"><h1>{{ product.title | escape }}</h1><p>Your favourite memories together in one premium black frame.</p><p class="mosaic-price" data-price>{{ master_frame.price | money }}</p>
<label for="mosaic-size-{{ section.id }}">Frame size</label><select id="mosaic-size-{{ section.id }}" data-size></select>
<label for="mosaic-direction-{{ section.id }}">Orientation</label><select id="mosaic-direction-{{ section.id }}" data-direction><option>Portrait</option><option>Landscape</option></select>
<div class="mosaic-actions"><button type="button" class="mosaic-button" data-open>Customise Now</button></div>
<fieldset class="mosaic-editor" data-editor hidden><legend class="visually-hidden">Customise your mosaic</legend>
        <div class="mosaic-step"><strong>1. Upload Background Photos</strong><p>Choose a minimum of 10 and a maximum of 50 photos. The collage arranges them automatically.</p><label class="mosaic-button" for="mosaic-background-{{ section.id }}">Choose background photos</label><input id="mosaic-background-{{ section.id }}" data-background type="file" accept="image/*" multiple><p data-count aria-live="polite">0 of 10 minimum photos selected</p><div class="mosaic-thumbs" data-thumbs></div></div>
        <div class="mosaic-step"><strong>2. Upload Main Photo</strong><p>Place your portrait over the photo mosaic. Background removal starts automatically after upload.</p><label class="mosaic-button" for="mosaic-main-{{ section.id }}">Upload main photo</label><input id="mosaic-main-{{ section.id }}" data-main type="file" accept="image/*"><p data-main-status aria-live="polite">No main photo selected</p><p data-position-hint hidden>On the preview: drag to move, pinch or drag the orange corner handle to resize.</p></div>

        <button type="button" class="mosaic-cart" data-save>Preview &amp; Save</button></fieldset>
<p class="mosaic-error" data-error role="alert" hidden></p><p class="mosaic-save-status" data-save-status role="status"></p><button class="mosaic-cart" type="button" data-cart disabled hidden>Add to Cart</button>
<p class="mosaic-trust"><span>Secure Checkout</span><span>Carefully Packed</span><span>Tracking Updates</span><span>Customer Support</span></p>
</div></div></div><script type="application/json" data-master-json>{"variants":{{ master_frame.variants | json }},"currency":{{ cart.currency.iso_code | json }}}</script>
</section><script src="{{ 'cartwala-mosaic.js' | asset_url }}" defer></script>
{% schema %}{"name":"Mosaic frame studio","settings":[]}{% endschema %}
