 confirming=true;const button=root.querySelector('#confirmOrder');button.disabled=true;
 const priorSelected=selected,priorSide=side;
 try{
  if(includeBack){if(fontLoads.has(backFont)){await fontLoads.get(backFont);if(!shopFonts.some(font=>font.id===backFont))throw new Error('The selected font could not load. Choose a different font before ordering.')}for(const shape of backShapes)if(shapeLoads.has(shape.id)){await shapeLoads.get(shape.id);if(!shapeImages.has(shape.id))throw new Error('A selected shop shape could not load. Choose a different shape before ordering.')}}
  const sourceUrls=[];for(let i=0;i<people.length;i++){orderStatus.textContent='Saving original photo '+(i+1)+' of '+people.length+'…';sourceUrls.push(await ensureOriginalUploaded(people[i],i))}
  const signature=JSON.stringify({photos:people.map(p=>[p.photoKey,p.size,p.crop,p.backName,p.roll]),sideOrder,includeBack,backFields,backValues,backTemplate,backLayout,backShapes,backFont,shopFontUrls:shopFonts.map(font=>font.url),shopShapeUrls:shapeChoices.filter(shape=>shape.url).map(shape=>shape.url),backPhotoId:backPhoto&&[backPhoto.name,backPhoto.size,backPhoto.lastModified]});
  if(printCache?.signature!==signature)printCache={signature,previews:[],prints:[]};
  const previewUrls=[],printUrls=[];
  let base=null,layout=null;
  if(people.some((_,i)=>!printCache.previews[i]?.front||!printCache.prints[i]?.front||(includeBack&&(!printCache.previews[i]?.back||!printCache.prints[i]?.back))))({base,layout}=await makePrintBase());
