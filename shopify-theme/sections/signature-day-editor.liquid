async function makePrintBase(){const base=document.createElement('canvas');base.width=PRINT_W;base.height=PRINT_H;const target=base.getContext('2d');target.fillStyle='#fff';target.fillRect(0,0,PRINT_W,PRINT_H);const layout=printLayout();for(let index=0;index<people.length;index++){orderStatus.textContent='Preparing A4 collage '+(index+1)+' of '+people.length+'…';const source=await originalImage(people[index]);const slot=layout.filled[sideOrder.indexOf(index)];printTile(target,source.image,slot.x,slot.y,layout.cw,layout.ch,people[index].crop);const repeats=layout.gaps.filter((_,i)=>cornerPhotoIndex(i,layout.gaps.length)===index);for(const gap of repeats)printTile(target,source.image,gap.x,gap.y,layout.cw,layout.ch,people[index].crop);source.close();await new Promise(resolve=>setTimeout(resolve,0))}return {base,layout}}
