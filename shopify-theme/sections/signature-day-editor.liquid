async function makeCenterTile(layout,index){const output=document.createElement('canvas');output.width=Math.round(layout.center*layout.cw);output.height=Math.round(layout.center*layout.ch);const focus=await originalImage(people[index]);printTile(output.getContext('2d'),focus.image,0,0,output.width,output.height,people[index].crop);focus.close();return output}
function makeBackPrint(index){const output=document.createElement('canvas');output.width=PRINT_W;output.height=PRINT_H;drawBackArtwork(output.getContext('2d'),index);return output}
function orderVariants(){const variants=JSON.parse(document.getElementById('signatureDayVariants').textContent||'[]'),tier=people.length>10?'11+ shirts':'1–10 shirts',unitPrice=(people.length>10?130:150)+(includeBack?30:0);return people.map(person=>{const match=variants.find(v=>v.available!==false&&String(v.option1||'').toUpperCase()===person.size&&String(v.option2||'').toLowerCase()===(includeBack?'front + back':'front only')&&String(v.option3||'')===tier&&Number(v.price)/100===unitPrice);if(!match)throw new Error('Checkout pricing is not ready for '+person.size+'. Your preview is safe; please try again after setup is complete.');return match.id})}
let confirming=false;
root.querySelector('#confirmOrder').onclick=async()=>{
