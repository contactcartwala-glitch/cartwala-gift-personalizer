<style>body:has(#signature-day-store) .sticky-atc,body:has(#signature-day-store) [data-sticky-atc]{display:none!important}</style>
<div id="signature-day-store" data-shop-font-1-name="{{ section.settings.font_1_name | escape }}" data-shop-font-1-url="{{ section.settings.font_1_url | escape }}" data-shop-font-2-name="{{ section.settings.font_2_name | escape }}" data-shop-font-2-url="{{ section.settings.font_2_url | escape }}" data-shop-font-3-name="{{ section.settings.font_3_name | escape }}" data-shop-font-3-url="{{ section.settings.font_3_url | escape }}">
 {% for slot in (1..6) %}
  {% capture shape_key %}shape_{{ slot }}{% endcapture %}
  {% capture shape_name_key %}shape_{{ slot }}_name{% endcapture %}
  {% assign merchant_shape = section.settings[shape_key] %}
  {% if merchant_shape %}<span class="back-shape-source" hidden data-shape-id="shop-shape-{{ slot }}" data-shape-name="{{ section.settings[shape_name_key] | default: 'Custom shape' | escape }}" data-shape-url="{{ merchant_shape | image_url: width: 1200 }}"></span>{% endif %}
 {% endfor %}
  <section class="product-intro" id="productIntro">
   <div class="product-photo">
    {% if product.featured_image %}
      <img id="signatureProductImage" src="{{ product.featured_image | image_url: width: 1100 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="1100" height="1100" fetchpriority="high">
    {% else %}
      <img id="signatureProductImage" src="https://cdn.shopify.com/s/files/1/0803/7931/4361/files/signature-day-white-shirt-mockup.png?v=1790180938" alt="White 120 GSM polyester Signature Day T-shirt with an A4 college collage" width="760" height="728">
    {% endif %}
    {% if product.images.size > 1 %}
      <div class="signature-product-thumbs" role="group" aria-label="Signature Day T-shirt photos">
       {% for gallery_image in product.images limit: 5 %}
        <button type="button" class="signature-product-thumb" data-gallery-src="{{ gallery_image | image_url: width: 1100 }}" data-gallery-alt="{{ gallery_image.alt | default: product.title | escape }}" aria-label="View product photo {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
         {{ gallery_image | image_url: width: 130 | image_tag: loading: 'lazy', width: 64, height: 64 }}
        </button>
       {% endfor %}
      </div>
    {% endif %}
   </div>
   <div class="product-details">
    <h1>{{ product.title | escape }}</h1>
    <p>Create a white 120 GSM polyester Signature Day T-shirt for each person in your group. Upload one photo per shirt: every collage shows the group, with its wearer's portrait larger in the centre.</p>
    <p class="product-highlights">120 GSM polyester · A4-proportion collage · Sizes XS–XXL · Optional back print for the whole group</p>
    <div class="product-offer"><span class="regular-price">₹250</span><strong>₹150 per T-shirt</strong><span>For 1–10 T-shirts</span></div>
    <div class="product-tier"><strong>11 or more T-shirts: ₹130 each</strong><span>The lower price applies to every T-shirt in the order.</span></div>
    <div class="product-tier"><strong>Optional back print: +₹30 per T-shirt</strong><span>Choose it for the whole order or leave every back blank.</span></div>
    <p class="product-count" id="productCount" aria-live="polite">The order total is calculated from the number of photos you upload.</p>
    <button class="next customize-button" id="customizeNow" type="button">Customize Now</button>
   </div>
  </section>
  <section class="product-extras" id="productExtras" aria-label="Delivery and shopping information">
    <div class="signature-delivery" aria-label="Estimated order and delivery dates">
      <ol class="signature-steps">
        <li><span class="signature-step-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 7h14l-1 14H6L5 7Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/><path d="m9 14 2 2 4-4"/></svg></span><strong>Ordered</strong><time id="signatureOrdered"></time></li>
        <li><span class="signature-step-icon" aria-hidden="true">{% render 'icon', name: 'truck', size: 26 %}</span><strong>Order Ready</strong><span id="signatureReady"></span></li>
        <li><span class="signature-step-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 5.2-8 12-8 12S4 15.2 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg></span><strong>Delivered</strong><span id="signatureDelivered"></span></li>
      </ol>
    </div>
    <div class="signature-confidence">
      <h2>{% render 'icon', name: 'shield', size: 26 %} <span>Shop with confidence</span></h2>
      <ul><li>{% render 'icon', name: 'shield', size: 24 %}<strong>Secure Checkout</strong></li><li>{% render 'icon', name: 'gift', size: 24 %}<strong>Carefully Packed</strong></li><li>{% render 'icon', name: 'truck', size: 24 %}<strong>Tracking Updates</strong></li><li>{% render 'icon', name: 'heart', size: 24 %}<strong>Customer Support</strong></li></ul>
    </div>
  </section>
  <section class="product-seo-content" id="productDescription" aria-label="Signature Day T-shirt details">
    <div class="signature-tabs" role="tablist" aria-label="Product information"><button type="button" id="signatureDescriptionTab" role="tab" aria-selected="true" aria-controls="signatureDescriptionPanel">Description</button><button type="button" id="signatureShippingTab" role="tab" aria-selected="false" aria-controls="signatureShippingPanel">Shipping</button></div>
    <div id="signatureDescriptionPanel" role="tabpanel" aria-labelledby="signatureDescriptionTab">{{ product.description }}</div>
    <div id="signatureShippingPanel" role="tabpanel" aria-labelledby="signatureShippingTab" hidden><p>Estimated making time: 2–3 days. Estimated shipping: 5–6 days. Delivery dates can vary by location. Tracking updates are provided after dispatch.</p></div>
  </section>
  <div class="editor" id="editor" hidden>
  <button class="back-to-product" id="backToProduct" type="button">← Product details</button>
  <h2 class="sd-heading">Customize {{ product.title | escape }}</h2>
  <p class="sd-subheading">A4 group collage preview · one uploaded photo = one T-shirt</p>
  <div class="sd-main">
 <section class="panel" id="setup">
  <h2>One class, one design per person</h2>
  <p>Every photo appears around the collage. Choose a person to see their portrait highlighted in the center of their T-shirt.</p>
  <div class="photo-upload-box">
   <strong>Group photos</strong>
   <p>Select multiple photos together. Each photo creates one T-shirt.</p>
   <button type="button" id="chooseGroupPhotos" class="photo-upload-trigger">＋ Choose group photos</button>
   <input class="photo-input" id="files" type="file" accept="image/*,.heic,.heif" multiple hidden aria-label="Upload multiple group photos" aria-describedby="photoUploadCount uploadStatus">
   <span id="photoUploadCount" class="photo-upload-count" role="status">No photos selected yet</span>
  </div>
  <button type="button" id="resetDesign" class="reset-design">Reset all photos and design</button>
  <p class="status" id="uploadStatus" role="status">Upload photos in any shape. The design crops every tile to one matching ratio between 1:1 and 2:3; the middle photo uses the same ratio at four times the width and height. On your phone, use Chrome if the picker closes inside ChatGPT.</p>
  <section class="back-config" id="backConfig">
   <h3>Back print for the whole order</h3>
   <label class="back-order-toggle"><input type="checkbox" id="includeBack"> Add back print to every T-shirt (+₹30 each)</label>
   <p>All T-shirts in this group have the same front/back choice. Select the details only if you want back printing.</p>
   <div class="back-choices" id="backChoices" hidden>
    <label><input type="checkbox" data-back-field="college"> College name</label>
    <label><input type="checkbox" data-back-field="name"> Student name</label>
    <label><input type="checkbox" data-back-field="roll"> Roll number</label>
    <label><input type="checkbox" data-back-field="group"> Group name</label>
    <label><input type="checkbox" data-back-field="year"> Academic year</label>
   </div>
   <p class="back-field-count" id="backFieldCount" aria-live="polite" hidden>Choose any 3 details (0 of 3 selected).</p>
   <fieldset class="back-templates" id="backTemplates" hidden><legend>Earlier back designs</legend>
    <label><input type="radio" name="signatureBackTemplate" value="crest" checked><span class="back-template-art crest-art" aria-hidden="true"></span><span><strong>Signature Crest</strong><small>Emblem and a prominent name</small></span></label>
    <label><input type="radio" name="signatureBackTemplate" value="ribbon"><span class="back-template-art ribbon-art" aria-hidden="true"></span><span><strong>Bold Batch</strong><small>Make the year or roll number stand out</small></span></label>
    <label><input type="radio" name="signatureBackTemplate" value="minimal"><span class="back-template-art minimal-art" aria-hidden="true"></span><span><strong>Minimal Premium</strong><small>Clean, spacious lettering</small></span></label>
   </fieldset>
   <div class="back-shared" id="backShared" hidden>
    <label data-shared="college">College name <input type="text" data-back-value="college" maxlength="70" placeholder="Enter college name"></label>
    <label data-shared="group">Group name <input type="text" data-back-value="group" maxlength="50" placeholder="Enter group name"></label>
    <label data-shared="year">Academic year <input type="text" data-back-value="year" maxlength="30" placeholder="For example, 2025–2026"></label>
   </div>
   <button type="button" class="back-layout-open" id="editBackLayout" hidden>Create Backside Design</button>
   <p class="back-help" id="backLayoutHelp" hidden>Arrange the selected details once. Sample name and roll number appear until you enter each student's details.</p>
   <p class="back-help" id="backHelp" hidden>For individual names and roll numbers, use the photo list below. Back printing applies to every shirt.</p>
   <p class="back-validation" id="backValidation" role="alert" hidden></p>
  </section>
  <div class="pricing" aria-live="polite"><strong>Price estimate</strong><div id="priceSummary"></div><small>Regular front price: ₹250 per shirt. 1–10 shirts: ₹150 each; 11+ shirts: ₹130 each. Back print: +₹30 per shirt when selected for the whole order.</small></div>
  <p class="notice">This preview stays in your browser. Sample portraits are colored placeholders; upload your photos to calculate the order price.</p>
  <div class="counts" id="counts"></div>
  <div class="roster" id="roster"></div>
  <button class="next" id="nextStep" type="button">Next: preview T-shirts →</button>
 </section>
 <section class="stage" id="previews" tabindex="-1" hidden>
  <div class="toolbar"><strong id="previewTitle"></strong><button type="button" id="download">Save this T-shirt preview</button></div>
  <div class="price-inline" id="previewPrice" aria-live="polite"></div>
  <div class="side-tabs" role="group" aria-label="T-shirt side"><button id="frontView" type="button" aria-pressed="true">Front</button><button id="backView" type="button" aria-pressed="false">Back</button></div>
  <canvas id="preview" width="1200" height="1400" aria-label="T-shirt preview"></canvas>
  <p class="back-preview-note" id="backPreviewNote" role="status" hidden></p>
  <div class="preview-nav"><button type="button" id="cropCenter">{{ section.settings.label_crop_center | escape }}</button><button type="button" id="previousShirt">← Previous T-shirt</button><button type="button" id="nextShirt">Next T-shirt →</button><button type="button" id="backToPhotos">Change photos / sizes</button></div>
  <button class="next review-button" id="reviewOrder" type="button">Check previews and total →</button>
  <p class="notice">Front and back artwork follow A4 proportions (210 × 297 mm). Review each shirt before ordering. Placement and print quality depend on production.</p>
 </section>
</div>
<section class="review-panel" id="orderReview" tabindex="-1" hidden>
 <h2>Review your T-shirts</h2>
 <p>Check every front and back preview before confirming the design.</p>
 <div id="reviewSummary"></div>
 <button type="button" id="returnToPreview">← Check previews again</button>
 <button type="button" class="next" id="confirmOrder">Add T-shirts to cart</button>
 <p class="status" id="orderStatus" role="status">Your original photos and print files will be saved before the cart popup opens.</p>
</section>
</div>

<dialog id="cropDialog" class="crop-dialog" aria-labelledby="cropTitle">
 <h2 id="cropTitle">Adjust photo</h2>
 <p>Drag to position the face. Pinch the photo or use the slider to zoom, then save. This crop is used in the collage and the center portrait.</p>
 <canvas id="cropCanvas" width="340" height="440" aria-label="Photo crop area"></canvas>
 <label for="cropZoom">Zoom</label><input id="cropZoom" type="range" min="1" max="3" step="0.02" value="1">
 <div class="crop-actions"><button type="button" id="cropReset">Reset</button><button type="button" id="cropCancel">Cancel</button><button type="button" id="cropSave" class="next">Save crop</button></div>
</dialog>
<dialog id="backLayoutDialog" class="back-layout-dialog" aria-labelledby="backLayoutTitle">
 <h2 id="backLayoutTitle">Create Backside Design</h2>
 <p>Tap a detail to select it. Drag its box to move it; drag the orange corner to resize it. Names and roll numbers will update separately on every shirt.</p>
 <div class="back-layout-tools">
  <label for="backLayoutElement">Selected detail</label><select id="backLayoutElement"></select>
  <label for="backLayoutPhoto">Photo or logo (optional)</label><div class="back-layout-upload"><label for="backLayoutPhoto" class="back-photo-trigger">＋ Add photo or logo</label><input id="backLayoutPhoto" class="back-photo-input" type="file" accept="image/*" aria-describedby="backPhotoName"><span id="backPhotoName">No photo added</span><button id="backLayoutRemovePhoto" type="button" aria-label="Remove uploaded photo" title="Remove photo" hidden>Remove ×</button></div>
  <label for="backLayoutColor">{{ section.settings.label_text_colour | escape }}</label><input id="backLayoutColor" type="color" value="#bb5018">
  <label for="backLayoutFont">Font for all back text</label><select id="backLayoutFont"><option value="system">Default</option></select>
  <details class="back-shape-picker"><summary>Select shape</summary><div id="backShapeGallery" class="back-shape-gallery" role="group" aria-label="Back design shapes"></div><p id="backShapeEmpty" hidden>Your shop has not added any shapes yet.</p><button type="button" id="backShapeRemove" class="back-shape-remove" hidden>Remove selected shape</button></details>
 </div>
 <canvas id="backLayoutCanvas" width="620" height="877" tabindex="0" aria-label="A4 back design. Drag an item to move it; drag its orange corner to resize. Drag the round arrow above a selected shape to rotate it."></canvas>
 <div class="crop-actions"><button id="backLayoutReset" type="button">Reset positions</button><button id="backLayoutCancel" type="button">Cancel</button><button id="backLayoutSave" type="button" class="next">Use for every T-shirt</button></div>
</dialog>
<dialog id="savedDialog" class="crop-dialog" aria-labelledby="savedTitle">
 <h2 id="savedTitle">Preview ready to save</h2>
 <p id="saveMessage">On iPhone, touch and hold the image below, then choose Save to Photos. You can also tap Download PNG.</p>
 <img id="savedImage" class="saved-image" alt="Saved T-shirt preview" width="280" height="327">
 <a id="downloadLink" class="download-link" download="signature-day-preview.png">Download PNG</a>
 <button id="savedClose" type="button" style="margin-top:10px;width:100%">Close</button>
</dialog>

</div>
<style>
@scope (#signature-day-store) {

#signature-day-store{font-family:system-ui,-apple-system,"Segoe UI",sans-serif;color:#191919;background:#f5f5f5}*{box-sizing:border-box}
.editor[hidden],.product-intro[hidden],.product-seo-content[hidden]{display:none}.product-intro{max-width:1160px;margin:28px auto;padding:24px;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(300px,.9fr);gap:32px;align-items:center;background:#fff;border:1px solid #e5e5e5;border-radius:18px}.product-photo{background:#f2efec;border-radius:14px;padding:16px}.product-photo img{display:block;width:100%;height:auto;object-fit:contain;background:#fff}.product-details h1{font-size:clamp(1.6rem,3vw,2.4rem);line-height:1.2;margin:0 0 12px}.product-details p{color:#555}.product-highlights{font-size:.88rem;color:#594738!important;font-weight:650}.product-offer{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;margin:22px 0 12px}.product-offer strong{font-size:1.55rem;color:#a74200}.regular-price{text-decoration:line-through;color:#777}.product-offer>span:last-child{width:100%;color:#555}.product-tier{display:grid;gap:4px;padding:13px 0;border-top:1px solid #e6e6e6}.product-tier span{color:#555}.product-count{padding:10px 12px;background:#fff5eb;border-radius:8px}.customize-button{font-size:1.1rem;max-width:360px;padding:14px 20px}.back-to-product{margin:20px max(24px,calc((100vw - 1320px)/2)) 0}.product-seo-content{max-width:1160px;margin:0 auto 28px;padding:22px 26px;background:#fff;border:1px solid #e8e4e0;border-radius:16px;color:#3c3734}.product-seo-content h2{font-size:1.25rem;line-height:1.3;margin:25px 0 10px}.product-seo-content h3{font-size:1rem;margin:17px 0 5px}.product-seo-content p,.product-seo-content li{line-height:1.65;color:#444}.product-seo-content ul,.product-seo-content ol{padding-left:22px}.product-seo-content li{margin:8px 0}
.product-extras{max-width:1160px;margin:0 auto 22px;padding:0 18px;display:grid;gap:18px}.product-extras[hidden]{display:none}.product-extras>div{border:1px solid #e2e2e2;border-radius:16px;padding:20px}.signature-delivery{background:#fff}.signature-steps{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;padding:0;margin:0}.signature-steps li{text-align:center;min-width:0;display:flex;flex-direction:column;align-items:center;gap:8px;font-size:.9rem;position:relative}.signature-steps li:not(:last-child):after{content:'';position:absolute;top:25px;left:calc(50% + 30px);width:calc(100% - 50px);max-width:90px;height:3px;border-radius:4px;background:#181818}.signature-steps strong{font-size:1rem;line-height:1.2}.signature-step-icon{background:#161616;color:#fff;display:grid;place-items:center;width:50px;height:50px;border-radius:50%}.signature-step-icon svg{width:26px;height:26px;display:block}.signature-steps time,.signature-steps li>span:last-child{color:#555;line-height:1.3;text-decoration:underline dotted #aaa;text-underline-offset:5px}.signature-confidence{background:#fffaf6}.signature-confidence h2{display:flex;align-items:center;gap:10px;font-size:1.25rem;line-height:1.25;margin:0 0 18px;color:#171717}.signature-confidence h2 svg{flex:none}.signature-confidence ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:10px}.signature-confidence li{background:#fff;border:1px solid #e8e8e8;border-radius:12px;padding:14px;display:flex;align-items:center;gap:12px;min-height:70px}.signature-confidence li svg{flex:none;color:#ff6a00}.signature-confidence li strong{font-size:.95rem;line-height:1.25;color:#292929}.product-seo-content .signature-tabs{display:flex;gap:28px;border-bottom:1px solid #eee}.signature-tabs button{border:0;border-bottom:2px solid transparent;border-radius:0;background:transparent;color:#666;font-weight:700;padding:12px 0;margin:0}.signature-tabs button[aria-selected=true]{border-bottom-color:#e65d48;color:#292929}.product-seo-content [role=tabpanel][hidden]{display:none}
.signature-product-thumbs{display:flex;justify-content:center;gap:10px;padding:12px 0 0}.signature-product-thumb{width:68px;height:68px;padding:2px;border:2px solid transparent;border-radius:9px;background:#fff;overflow:hidden}.signature-product-thumb[aria-pressed=true]{border-color:#f47700}.signature-product-thumb img{display:block;width:100%;height:100%;object-fit:cover}.product-photo #signatureProductImage{aspect-ratio:1/1;object-fit:contain}
.review-button{max-width:430px}.review-panel{max-width:920px;margin:20px auto;padding:24px;background:#fff;border:1px solid #ddd;border-radius:16px}.review-panel[hidden]{display:none}.review-panel h2{margin:0}.review-panel dl{display:grid;grid-template-columns:1fr auto;gap:10px;margin:16px 0 20px}.review-panel dt,.review-panel dd{margin:0;padding:8px 0;border-bottom:1px solid #eee}.review-panel dd{text-align:right;font-weight:650}.review-panel .review-total{font-size:1.2rem;color:#a74200;font-weight:750}.review-panel button{margin-top:6px}
header{background:#fff;border-bottom:1px solid #ddd;padding:16px max(20px,calc((100vw - 1320px)/2))}
header strong{font-size:1.25rem}header span{color:#666;margin-left:12px}
.sd-main{max-width:1320px;margin:auto;padding:24px;display:grid;grid-template-columns:340px minmax(0,1fr);gap:24px}
.panel,.stage{background:#fff;border:1px solid #ddd;border-radius:16px;padding:22px}.panel{align-self:start}
h1{font-size:1.35rem;margin:0 0 10px}p{line-height:1.5;color:#555;margin:8px 0 16px}
label{display:block;font-weight:650;margin:16px 0 7px}.presets{display:flex;gap:8px}
button{border:1px solid #d1d1d1;background:#fff;color:#222;border-radius:10px;padding:11px 14px;font:inherit;cursor:pointer}
button[aria-pressed=true],button:hover{border-color:#ed7100;background:#fff2e8}
.photo-input{display:block;width:100%;max-width:100%;font:inherit;color:#333;padding:9px;border:1px solid #ddd;border-radius:10px;background:#fff}
.photo-input::file-selector-button{background:#f47700;color:#fff;border:0;border-radius:8px;padding:12px 15px;font:inherit;font-weight:700;margin-right:10px}
.photo-upload-box{margin:18px 0;padding:18px;border:2px solid #ed7100;border-radius:14px;background:#fff5eb;box-shadow:0 4px 18px #ed71001c}.photo-upload-box label{margin:0;font-size:1.17rem;color:#8f3600}.photo-upload-box p{margin:7px 0 13px;font-size:.9rem}
.back-field-count{font-weight:700;color:#9b4300}.back-templates{display:grid;gap:8px;margin:16px 0;padding:12px;border:1px solid #edb77f;border-radius:12px}.back-templates legend{font-weight:750;padding:0 6px}.back-templates label{display:flex;gap:10px;align-items:center;padding:10px;margin:0;border:1px solid #ddd;border-radius:10px;background:#fff;cursor:pointer}.back-templates label:has(input:checked){border:2px solid #ed7100;background:#fff1e5}.back-templates input{accent-color:#ed7100}.back-templates small{display:block;color:#666;font-weight:400}.back-templates[hidden],.back-field-count[hidden]{display:none}
.back-template-art{position:relative;flex:none;width:46px;height:63px;background:#fff;border:1px solid #d9c2b6;border-radius:3px;box-shadow:0 2px 4px #0002}.back-template-art:before,.back-template-art:after{content:'';position:absolute;left:20%;width:60%;border-radius:2px}.crest-art{border:2px solid #252525}.crest-art:before{top:9%;left:32%;width:36%;height:25%;border:2px solid #c25719;border-radius:35% 35% 6px 6px}.crest-art:after{top:46%;height:4px;background:#242424;box-shadow:0 9px #c25719,0 18px #242424}.ribbon-art:before{top:12%;left:13%;width:74%;height:3px;background:#c25719}.ribbon-art:after{top:35%;left:10%;width:80%;height:12px;background:#252525;box-shadow:0 16px #c25719}.minimal-art:before{top:17%;left:12%;width:76%;height:2px;background:#242424}.minimal-art:after{top:40%;left:12%;width:76%;height:5px;background:#252525;box-shadow:0 12px #252525,0 22px #c25719}
.reset-design{margin-top:12px;color:#9b3500;border-color:#e8bca7}
.next{display:block;width:100%;background:#f47700;color:#fff;border:0;font-weight:750;margin-top:12px}.next:hover{background:#d86100;color:#fff}
.status{min-height:1.4em;color:#60400d;font-size:.94rem}.preview-nav{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}
.roster{max-height:420px;overflow:auto;margin-top:15px}.person{display:grid;grid-template-columns:34px minmax(0,1fr) 51px 51px 66px;align-items:center;gap:4px;width:100%;text-align:left;margin:5px 0;padding:5px}
