<section class="cw-home-categories section">
  <div class="page-width">
    <div class="section-header">
      <div>
        {% if section.settings.eyebrow != blank %}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{% endif %}
        {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
      </div>
      {% if section.settings.link_label != blank and section.settings.link_url != blank %}
        <a class="btn btn-outline btn-sm" href="{{ section.settings.link_url }}">{{ section.settings.link_label | escape }}</a>
      {% endif %}
    </div>
    <div class="cw-home-categories__grid">
      {% for block in section.blocks %}
        {% liquid
          assign category = block.settings.collection
          assign photo = block.settings.image | default: category.image
          assign title = block.settings.title | default: category.title
        %}
        {% if category != blank %}
          <a class="cw-home-categories__card" href="{{ category.url }}" {{ block.shopify_attributes }}>
            <div class="cw-home-categories__photo">
              {% if photo != blank %}
                {{ photo | image_url: width: 800 | image_tag: loading: 'lazy', widths: '240, 400, 600, 800', sizes: '(min-width: 990px) 300px, 50vw', alt: title }}
              {% endif %}
            </div>
            <h3>{{ title | escape }}</h3>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% stylesheet %}
.cw-home-categories { padding: 34px 0; }
.cw-home-categories .section-header { margin-bottom: 20px; }
.cw-home-categories__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
.cw-home-categories__card { display: block; color: inherit; text-decoration: none; overflow: hidden; border: 1px solid #e5e5e5; border-radius: 14px; background: #fff; transition: border-color .2s ease; }
.cw-home-categories__photo { aspect-ratio: 1; overflow: hidden; background: #f7f6f3; }
.cw-home-categories__photo img { display: block; width: 100%; height: 100%; object-fit: contain; }
.cw-home-categories__card h3 { margin: 0; padding: 16px 10px; text-align: center; font-size: clamp(16px, 1.5vw, 21px); line-height: 1.3; }
.cw-home-categories__card:hover { border-color: #ff6a00; }
.cw-home-categories__card:focus-visible { outline: 3px solid #ff6a00; outline-offset: 3px; }
@media (min-width: 750px) { .cw-home-categories__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; } }
@media (min-width: 990px) { .cw-home-categories .page-width { max-width: 1320px; padding-left: 32px; padding-right: 32px; } }
{% endstylesheet %}
{% schema %}
{
  "name": "Shop by category",
  "max_blocks": 12,
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Explore"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category"},
    {"type": "text", "id": "link_label", "label": "View all label", "default": "View All"},
    {"type": "url", "id": "link_url", "label": "View all link"}
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {"type": "collection", "id": "collection", "label": "Collection"},
        {"type": "text", "id": "title", "label": "Display name"},
        {"type": "image_picker", "id": "image", "label": "Photo override"}
      ]
    }
  ],
  "presets": [{"name": "Shop by category"}]
}
{% endschema %}
